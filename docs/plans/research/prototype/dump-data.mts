// Writes app/data.js: the prototype's test items, scale labels, and the level-to-tier table, all taken from the app's
// own modules, so the prototype's scene and scan estimates land on the same tiers as the 147-item scoring.
// Usage (repo root): npx tsx docs/plans/research/prototype/dump-data.mts > docs/plans/research/prototype/app/data.js
import { buildItemSequence, itemText, LIKERT } from '../../../../src/shared/i18n/items';
import { SHADOW_PARTS, RESOURCES, POLARIZATIONS, GUARDS, NORM_MEAN, NORM_SD, RESOURCE_NORM_MEAN, RESOURCE_NORM_SD } from '../../../../src/shared/core/data/parts';
import { scoreProfile } from '../../../../src/shared/core/data/scoring-v2';
import { toAssessmentInput } from '../../../../src/shared/core/data/assessment-adapter';
import { IV_PARTS } from '../../../../src/shared/features/landing/stickers';
import { clinicalPolarizationName } from '../../../../src/parts-cartographer/core/clinical-profile-adapter';
import { PARTS } from './cast.ts';

// Neutral answers: shadow parts at 2 ("иногда"), resources and Self at 3. A level then moves only one family.
function answersFor(level: Record<string, number>): number[] {
  return buildItemSequence().map((ref) => {
    if (ref.kind === 'shadow') { const l = level[ref.part] ?? 2; return ref.index >= 6 ? 6 - l : l; }
    if (ref.kind === 'resource') return level[ref.part] ?? 3;
    if (ref.kind === 'self') return level.self ?? 3;
    return ref.which === 'attention' ? 3 : 1;
  });
}

const items = buildItemSequence().map((ref) => {
  const text = itemText(ref, 'ru');
  if (ref.kind === 'shadow') return { k: 's', p: ref.part, i: ref.index, t: text };
  if (ref.kind === 'resource') return { k: 'r', p: ref.part, i: ref.index, t: text };
  if (ref.kind === 'self') return { k: 'f', i: ref.index, t: text };
  return { k: 'v', w: ref.which, t: text };
});

// level -> T and tier for each family, measured with the app's scoring.
const levelTable: Record<string, { T: number; tier: string }[]> = {};
for (const id of [...SHADOW_PARTS, ...RESOURCES]) {
  const row: { T: number; tier: string }[] = [];
  for (let level = 1; level <= 5; level += 1) {
    const raw = scoreProfile(toAssessmentInput(answersFor({ [id]: level })));
    const found = (raw.parts as Record<string, { T: number; tier: string }>)[id] ?? (raw.resources as Record<string, { T: number; tier: string }>)[id];
    row.push({ T: Math.round(found.T), tier: found.tier });
  }
  levelTable[id] = row;
}

const baselines = Object.fromEntries(IV_PARTS.map((part) => [part.id, { fam: part.fam, color: part.color, ax: part.ax, name: part.name[1] }]));

const data = {
  likert: LIKERT.ru,
  items,
  levelTable,
  norms: { shadow: { mean: NORM_MEAN, sd: NORM_SD }, resource: { mean: RESOURCE_NORM_MEAN, sd: RESOURCE_NORM_SD } },
  baselines,
  polarizations: POLARIZATIONS.map(([a, b, name]) => [a, b, clinicalPolarizationName(name, 'ru')]),
  guards: GUARDS,
  traits: PARTS,
};

process.stdout.write('/* Generated by dump-data.mts from the app modules. Do not edit by hand. */\nwindow.INNER_DATA = ' + JSON.stringify(data) + ';\n');
