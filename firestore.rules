rules_version = '2';

// ============================================================================
// ArchetypeAI — Firestore Security Rules
//
// Cross-user assessment access is limited to (a) a verified allowlisted admin
// with an adminClients relationship, or (b) a therapist with an active,
// client-created appointment share. Admins are allowlisted by verified Firebase
// email; the bootstrap account is intentionally pinned here and in
// AdminAccessService. Add/remove other admins through the admin UI.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return hasVerifiedEmail()
        && (
          request.auth.token.email == 'admin@example.com'
          || exists(/databases/$(database)/documents/adminAllowlist/$(request.auth.token.email))
        );
    }

    function hasActiveAppointment(clientUid, therapistUid, appointmentId) {
      let appointmentPath = /databases/$(database)/documents/appointments/$(appointmentId);
      return appointmentId is string
        && exists(appointmentPath)
        && get(appointmentPath).data.clientUid == clientUid
        && get(appointmentPath).data.therapistUid == therapistUid
        && (
          get(appointmentPath).data.status == 'pending'
          || get(appointmentPath).data.status == 'approved'
        );
    }

    function therapistBusySlotPath(therapistUid, start) {
      return /databases/$(database)/documents/therapistBusySlots/$(therapistUid + '_' + start);
    }

    // Optional schemaVersion-2 zone time written by the booking flow (see core/appointment-time.ts).
    // Bounded keys and sizes only; the zone name is checked by the client's IANA validator.
    function validZoneTime(time) {
      return time is map
        && time.keys().hasOnly(['schemaVersion', 'startUtc', 'endUtc', 'durationMinutes', 'timeZone', 'wallStart', 'repeatedWallTime', 'source'])
        && time.schemaVersion == 2
        && time.startUtc is string && time.startUtc.size() <= 40
        && time.endUtc is string && time.endUtc.size() <= 40
        && time.durationMinutes is int
        && time.timeZone is string && time.timeZone.size() <= 64
        && time.wallStart is string && time.wallStart.size() <= 16
        && time.source is map && time.source.size() <= 8;
    }

    function hasMatchingBusySlotAfter(therapistUid, start, end, appointmentId) {
      let busyPath = therapistBusySlotPath(therapistUid, start);
      return existsAfter(busyPath)
        && getAfter(busyPath).data.therapistUid == therapistUid
        && getAfter(busyPath).data.appointmentId == appointmentId
        && getAfter(busyPath).data.start == start
        && getAfter(busyPath).data.end == end;
    }

    function hasValidBookingShare(clientUid, therapistUid, appointmentId) {
      let sharePath = /databases/$(database)/documents/clientShares/$(therapistUid + '_' + clientUid);
      return exists(sharePath)
        && get(sharePath).data.clientUid == clientUid
        && get(sharePath).data.therapistUid == therapistUid
        && get(sharePath).data.source == 'booking'
        && get(sharePath).data.appointmentId == appointmentId
        && hasActiveAppointment(clientUid, therapistUid, appointmentId);
    }

    function hasValidInviteLink(clientUid, linkCode) {
      let invitePath = /databases/$(database)/documents/therapistLinks/$(linkCode);
      return linkCode is string
        && exists(invitePath)
        && get(invitePath).data.clientUid == clientUid
        && get(invitePath).data.summary is map;
    }

    function validShareCodePayload(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt', 'schema', 'mapSnapshot', 'assessment'])
        && data.uid is string
        && data.createdAt is string
        && (
          (!('schema' in data) && !('mapSnapshot' in data) && !('assessment' in data))
          || (
            data.schema == 'parts-cartographer.v1'
            && data.mapSnapshot is map
            && !('assessment' in data)
            && data.mapSnapshot.keys().hasAll(['schema', 'profile', 'parts', 'createdAt', 'updatedAt'])
            && data.mapSnapshot.keys().hasOnly(['schema', 'profile', 'parts', 'createdAt', 'updatedAt'])
            && data.mapSnapshot.profile is map
            && data.mapSnapshot.parts is list
            && data.mapSnapshot.parts.size() <= 100
            && data.mapSnapshot.createdAt is string
            && data.mapSnapshot.updatedAt is string
          )
          || (
            data.assessment is map
            && !('schema' in data)
            && !('mapSnapshot' in data)
            && data.assessment.keys().hasAll(['responses', 'dimensionalExpressions', 'results', 'scoringMethod', 'updatedAt'])
            && data.assessment.keys().hasOnly(['responses', 'dimensionalExpressions', 'results', 'scoringMethod', 'updatedAt'])
            && data.assessment.responses is list
            && data.assessment.responses.size() <= 200
            && data.assessment.dimensionalExpressions is map
            && (data.assessment.results == null || data.assessment.results is map)
            && (data.assessment.scoringMethod == 'deterministic' || data.assessment.scoringMethod == 'fallback')
            && data.assessment.updatedAt is string
          )
        );
    }

    function hasTrustedTherapistClientLink(therapistUid, clientUid) {
      let rosterPath = /databases/$(database)/documents/therapistClients/$(therapistUid + '_' + clientUid);
      return exists(rosterPath)
        && get(rosterPath).data.therapistUid == therapistUid
        && get(rosterPath).data.clientUid == clientUid
        && (
          (
            get(rosterPath).data.source == 'booking'
            && hasValidBookingShare(clientUid, therapistUid, get(rosterPath).data.appointmentId)
          )
          ||
          (
            get(rosterPath).data.source == 'invite'
            && hasValidInviteLink(clientUid, get(rosterPath).data.linkCode)
          )
        );
    }

    function hasTherapistReadGrant(userId) {
      return isSignedIn()
        && hasValidBookingShare(userId, request.auth.uid,
          get(/databases/$(database)/documents/clientShares/$(request.auth.uid + '_' + userId)).data.appointmentId);
    }

    function hasAdminReadGrant(userId) {
      return isAdmin()
        && exists(/databases/$(database)/documents/adminClients/$(request.auth.uid + '_' + userId))
        && get(/databases/$(database)/documents/adminClients/$(request.auth.uid + '_' + userId)).data.adminUid == request.auth.uid
        && get(/databases/$(database)/documents/adminClients/$(request.auth.uid + '_' + userId)).data.clientUid == userId;
    }

    function validTherapistSummary(summary) {
      return summary is map
        && summary.keys().hasAll(['headline', 'burden', 'selfEnergy', 'parts', 'activeComplexes', 'copingStack', 'adherence'])
        && summary.keys().hasOnly(['headline', 'burden', 'selfEnergy', 'parts', 'activeComplexes', 'copingStack', 'adherence'])
        && summary.headline is string
        && summary.headline.size() <= 160
        && summary.burden is number
        && summary.selfEnergy is number
        && summary.parts is map
        && summary.activeComplexes is list
        && summary.activeComplexes.size() <= 50
        && summary.copingStack is map
        && summary.adherence is map;
    }

    // ---------- user-owned data ----------
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /assessment/{docId} {
        allow read: if isOwner(userId) || hasAdminReadGrant(userId) || hasTherapistReadGrant(userId);
        allow write: if isOwner(userId);
      }

      match /history/{docId} {
        allow read: if isOwner(userId) || hasAdminReadGrant(userId) || hasTherapistReadGrant(userId);
        allow write: if isOwner(userId);
      }

      match /connections/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /synastry/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Anonymous telemetry is still tied to a Firebase Auth session. No reads,
    // updates, or deletes are available to clients.
    match /telemetryResponses/{docId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['payload', 'at'])
        && request.resource.data.keys().hasOnly(['payload', 'at'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 32768
        && request.resource.data.at is string
        && request.resource.data.at.size() <= 40;
    }

    // FCM registration is private to the Firebase user that owns the token.
    match /pushTokens/{token} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['token', 'uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['token', 'uid', 'createdAt'])
        && request.resource.data.token == token
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['token', 'uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['token', 'uid', 'createdAt'])
        && request.resource.data.token == token
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Public, read-only app configuration.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Share-code lookup must be a single-document get, never a collection list.
    // Codes are bearer links, so only authenticated users can resolve one.
    match /shareCodes/{code} {
      allow get: if isSignedIn() && code.matches('^[a-z0-9]{8,16}$');
      allow list: if false;
      allow create: if code.matches('^[a-z0-9]{8,16}$')
        && isOwner(request.resource.data.uid)
        && validShareCodePayload(request.resource.data);
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && code.matches('^[a-z0-9]{8,16}$')
        && validShareCodePayload(request.resource.data);
      allow delete: if isOwner(resource.data.uid);
    }

    // Therapist invite codes carry only the summary the client consented to
    // share. `get` is the bearer-code redemption flow; listing is prohibited.
    match /therapistLinks/{code} {
      allow get: if isSignedIn() && code.matches('^[A-Z0-9]{6,10}$');
      allow list: if false;
      allow create: if isOwner(request.resource.data.clientUid)
        && code.matches('^[A-Z0-9]{6,10}$')
        && request.resource.data.keys().hasAll(['clientUid', 'createdAt', 'summary'])
        && request.resource.data.keys().hasOnly(['clientUid', 'createdAt', 'summary'])
        && request.resource.data.createdAt is string
        && validTherapistSummary(request.resource.data.summary);
      allow update: if false;
      allow delete: if isOwner(resource.data.clientUid);
    }

    // Admin allowlist: only an already-authorized, verified admin can manage
    // entries. A user can get only their own entry to support the client-side
    // role check; collection listing is admin-only.
    match /adminAllowlist/{email} {
      allow get: if isAdmin()
        || (isSignedIn() && request.auth.token.email is string && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.email == email
        && request.resource.data.keys().hasAll(['email', 'createdAt', 'createdByUid'])
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'createdByUid'])
        && request.resource.data.createdAt is string
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.email == email
        && request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if isAdmin();
    }

    // Specialist-client relationships are privileged and cannot be self-issued
    // by ordinary signed-in users.
    match /adminClients/{docId} {
      // Keep this condition field-based: the admin dashboard queries by
      // `adminUid`, and Firestore rules do not filter query results by doc ID.
      allow read: if isAdmin()
        && resource.data.adminUid == request.auth.uid;
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.clientUid is string
        && request.resource.data.clientUid != request.auth.uid
        && docId == request.resource.data.adminUid + '_' + request.resource.data.clientUid
        && request.resource.data.keys().hasAll(['adminUid', 'clientUid', 'clientEmail', 'notes', 'addedAt', 'addedByUid'])
        && request.resource.data.keys().hasOnly(['adminUid', 'clientUid', 'clientEmail', 'notes', 'addedAt', 'addedByUid'])
        && (request.resource.data.clientEmail == null || request.resource.data.clientEmail is string)
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 4000
        && request.resource.data.addedAt is string
        && request.resource.data.addedByUid == request.auth.uid;
      allow update: if isAdmin()
        && resource.data.adminUid == request.auth.uid
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.clientUid == resource.data.clientUid
        && docId == request.resource.data.adminUid + '_' + request.resource.data.clientUid
        && request.resource.data.keys().hasAll(['adminUid', 'clientUid', 'clientEmail', 'notes', 'addedAt', 'addedByUid'])
        && request.resource.data.keys().hasOnly(['adminUid', 'clientUid', 'clientEmail', 'notes', 'addedAt', 'addedByUid'])
        && (request.resource.data.clientEmail == null || request.resource.data.clientEmail is string)
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 4000
        && request.resource.data.addedByUid == resource.data.addedByUid;
      allow delete: if isAdmin()
        && resource.data.adminUid == request.auth.uid
        && docId == resource.data.adminUid + '_' + resource.data.clientUid;
    }

    // The directory contains only a user's own email/display-name projection.
    // Signed-in users can resolve a therapist by email; writes stay owner-only.
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['emailLower', 'email', 'displayName', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['emailLower', 'email', 'displayName', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailLower is string
        && request.resource.data.emailLower == request.auth.token.email
        && (request.resource.data.displayName == null || request.resource.data.displayName is string)
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(userId);
    }

    // Therapist availability is visible only to signed-in users. A profile may
    // be created/edited by its owner and carries no arbitrary extra fields.
    match /therapists/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasAll(['email', 'availability'])
        && request.resource.data.keys().hasOnly(['email', 'availability', 'statement'])
        && (request.resource.data.email == null || request.resource.data.email is string)
        && request.resource.data.availability is list
        && request.resource.data.availability.size() <= 14
        // Optional public statement. Empty string means none; the client checks the content first.
        && (!('statement' in request.resource.data) || (request.resource.data.statement is string && request.resource.data.statement.size() <= 600));
      allow delete: if false;
    }

    // Busy-slot projection exposes only scheduling fields, never client email
    // or UID. A deterministic therapist+start document is the client-side
    // concurrency lock for a generated appointment slot.
    match /therapistBusySlots/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['therapistUid', 'appointmentId', 'start', 'end'])
        && request.resource.data.keys().hasOnly(['therapistUid', 'appointmentId', 'start', 'end'])
        && request.resource.data.therapistUid is string
        && request.resource.data.appointmentId is string
        && request.resource.data.start is string
        && request.resource.data.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
        && request.resource.data.end is string
        && request.resource.data.end.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
        && request.resource.data.end > request.resource.data.start
        && id == request.resource.data.therapistUid + '_' + request.resource.data.start
        && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
        && (
          getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.clientUid == request.auth.uid
          || getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.therapistUid == request.auth.uid
        )
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.therapistUid == request.resource.data.therapistUid
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.start == request.resource.data.start
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.end == request.resource.data.end
        && (
          getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.status == 'pending'
          || getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.status == 'approved'
        );
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.appointmentId is string
        && existsAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId))
        && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.therapistUid == resource.data.therapistUid
        && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.start == resource.data.start
        && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.end == resource.data.end
        && (
          getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.clientUid == request.auth.uid
          || getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.therapistUid == request.auth.uid
        )
        && (
          getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status == 'declined'
          || getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status == 'cancelled'
        );
    }

    // Appointment creation is a client request to a real therapist profile.
    // The parties and scheduling fields are immutable; only a constrained
    // status transition is allowed afterwards.
    match /appointments/{id} {
      allow read: if isSignedIn()
        && (resource.data.clientUid == request.auth.uid || resource.data.therapistUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['clientUid', 'clientEmail', 'therapistUid', 'therapistEmail', 'start', 'end', 'status', 'createdAt', 'accessGranted'])
        && request.resource.data.keys().hasOnly(['clientUid', 'clientEmail', 'therapistUid', 'therapistEmail', 'start', 'end', 'status', 'createdAt', 'accessGranted', 'time'])
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.clientEmail == request.auth.token.email
        && request.resource.data.therapistUid is string
        && request.resource.data.therapistUid != request.auth.uid
        && exists(/databases/$(database)/documents/therapists/$(request.resource.data.therapistUid))
        && request.resource.data.therapistEmail == get(/databases/$(database)/documents/therapists/$(request.resource.data.therapistUid)).data.email
        && request.resource.data.start is string
        && request.resource.data.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
        && request.resource.data.end is string
        && request.resource.data.end.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
        && request.resource.data.end > request.resource.data.start
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.accessGranted == true
        && (!('time' in request.resource.data) || validZoneTime(request.resource.data.time))
        && hasMatchingBusySlotAfter(
          request.resource.data.therapistUid,
          request.resource.data.start,
          request.resource.data.end,
          id
        );
      allow update: if isSignedIn()
        && (
          (
            resource.data.therapistUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && (
              request.resource.data.status == 'approved'
              || (
                request.resource.data.status == 'declined'
                && !existsAfter(therapistBusySlotPath(resource.data.therapistUid, resource.data.start))
              )
            )
          )
          ||
          (
            resource.data.clientUid == request.auth.uid
            && (resource.data.status == 'pending' || resource.data.status == 'approved')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled'
            && !existsAfter(therapistBusySlotPath(resource.data.therapistUid, resource.data.start))
          )
        );
      allow delete: if false;
    }

    // A booking share must point to a real appointment created by this client
    // for this therapist. That live relationship also gates assessment/history
    // reads while the appointment remains pending or approved.
    match /clientShares/{docId} {
      allow read: if isSignedIn()
        && (resource.data.clientUid == request.auth.uid || resource.data.therapistUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['clientUid', 'clientEmail', 'therapistUid', 'grantedAt', 'source', 'appointmentId'])
        && request.resource.data.keys().hasOnly(['clientUid', 'clientEmail', 'therapistUid', 'grantedAt', 'source', 'appointmentId'])
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.clientEmail == request.auth.token.email
        && request.resource.data.therapistUid is string
        && docId == request.resource.data.therapistUid + '_' + request.resource.data.clientUid
        && request.resource.data.source == 'booking'
        && request.resource.data.grantedAt is string
        && hasActiveAppointment(request.auth.uid, request.resource.data.therapistUid, request.resource.data.appointmentId);
      allow update: if isSignedIn()
        && resource.data.clientUid == request.auth.uid
        && request.resource.data.clientUid == resource.data.clientUid
        && request.resource.data.therapistUid == resource.data.therapistUid
        && docId == request.resource.data.therapistUid + '_' + request.resource.data.clientUid
        && request.resource.data.keys().hasAll(['clientUid', 'clientEmail', 'therapistUid', 'grantedAt', 'source', 'appointmentId'])
        && request.resource.data.keys().hasOnly(['clientUid', 'clientEmail', 'therapistUid', 'grantedAt', 'source', 'appointmentId'])
        && request.resource.data.clientEmail == request.auth.token.email
        && request.resource.data.source == 'booking'
        && request.resource.data.grantedAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientEmail', 'grantedAt', 'source', 'appointmentId'])
        && hasActiveAppointment(request.auth.uid, request.resource.data.therapistUid, request.resource.data.appointmentId);
      allow delete: if isOwner(resource.data.clientUid);
    }

    // A therapist/client roster row is valid only when backed by a booking share
    // or a client-created invite code. Clients may add their own booking row;
    // therapists may claim a code and maintain archive state.
    match /therapistClients/{docId} {
      allow read: if isSignedIn()
        && (resource.data.therapistUid == request.auth.uid || resource.data.clientUid == request.auth.uid);
      allow create: if isSignedIn()
        && docId == request.resource.data.therapistUid + '_' + request.resource.data.clientUid
        && (
          (
            request.resource.data.source == 'booking'
            && request.resource.data.clientUid == request.auth.uid
            && request.resource.data.keys().hasAll(['therapistUid', 'clientUid', 'clientEmail', 'linkedAt', 'source', 'appointmentId'])
            && request.resource.data.keys().hasOnly(['therapistUid', 'clientUid', 'clientEmail', 'linkedAt', 'source', 'appointmentId'])
            && request.resource.data.clientEmail == request.auth.token.email
            && request.resource.data.linkedAt is string
            && hasValidBookingShare(request.auth.uid, request.resource.data.therapistUid, request.resource.data.appointmentId)
          )
          ||
          (
            request.resource.data.source == 'invite'
            && request.resource.data.therapistUid == request.auth.uid
            && request.resource.data.keys().hasAll(['therapistUid', 'clientUid', 'linkedAt', 'source', 'linkCode', 'summary'])
            && request.resource.data.keys().hasOnly(['therapistUid', 'clientUid', 'linkedAt', 'source', 'linkCode', 'summary'])
            && request.resource.data.linkedAt is string
            && validTherapistSummary(request.resource.data.summary)
            && hasValidInviteLink(request.resource.data.clientUid, request.resource.data.linkCode)
            && get(/databases/$(database)/documents/therapistLinks/$(request.resource.data.linkCode)).data.summary == request.resource.data.summary
          )
        );
      allow update: if isSignedIn()
        && resource.data.therapistUid == request.resource.data.therapistUid
        && resource.data.clientUid == request.resource.data.clientUid
        && docId == request.resource.data.therapistUid + '_' + request.resource.data.clientUid
        && (
          (
            request.resource.data.therapistUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived'])
            && request.resource.data.archived is bool
          )
          ||
          (
            request.resource.data.source == 'invite'
            && request.resource.data.therapistUid == request.auth.uid
            && request.resource.data.keys().hasAll(['therapistUid', 'clientUid', 'linkedAt', 'source', 'linkCode', 'summary'])
            && request.resource.data.keys().hasOnly(['therapistUid', 'clientUid', 'clientEmail', 'linkedAt', 'archived', 'source', 'appointmentId', 'linkCode', 'summary'])
            && request.resource.data.linkedAt is string
            && validTherapistSummary(request.resource.data.summary)
            && hasValidInviteLink(request.resource.data.clientUid, request.resource.data.linkCode)
            && get(/databases/$(database)/documents/therapistLinks/$(request.resource.data.linkCode)).data.summary == request.resource.data.summary
          )
          ||
          (
            request.resource.data.source == 'booking'
            && request.resource.data.clientUid == request.auth.uid
            && request.resource.data.keys().hasAll(['therapistUid', 'clientUid', 'clientEmail', 'linkedAt', 'source', 'appointmentId'])
            && request.resource.data.keys().hasOnly(['therapistUid', 'clientUid', 'clientEmail', 'linkedAt', 'archived', 'source', 'appointmentId', 'linkCode', 'summary'])
            && request.resource.data.clientEmail == request.auth.token.email
            && request.resource.data.linkedAt is string
            && hasValidBookingShare(request.auth.uid, request.resource.data.therapistUid, request.resource.data.appointmentId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientEmail', 'linkedAt', 'source', 'appointmentId'])
          )
        );
      allow delete: if isSignedIn() && resource.data.therapistUid == request.auth.uid;
    }

    // Exercise assignments may be authored only by a therapist with a trusted
    // roster relationship. The linked client and therapist may read the result.
    match /assignments/{id} {
      allow read: if isSignedIn()
        && (resource.data.clientUid == request.auth.uid || resource.data.therapistUid == request.auth.uid);
      allow create: if isOwner(request.resource.data.therapistUid)
        && request.resource.data.id == id
        && request.resource.data.clientUid is string
        && hasTrustedTherapistClientLink(request.auth.uid, request.resource.data.clientUid)
        && request.resource.data.keys().hasAll(['id', 'therapistUid', 'clientUid', 'exerciseId', 'frequency', 'assignedAt'])
        && request.resource.data.keys().hasOnly(['id', 'therapistUid', 'clientUid', 'exerciseId', 'frequency', 'assignedAt', 'note'])
        && request.resource.data.exerciseId is string
        && request.resource.data.exerciseId.size() <= 120
        && (request.resource.data.frequency == 'once'
          || request.resource.data.frequency == 'daily'
          || request.resource.data.frequency == 'weekly'
          || request.resource.data.frequency == 'after-trigger')
        && request.resource.data.assignedAt is string
        && request.resource.data.assignedAt.size() <= 40
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 1000));
      allow update, delete: if false;
    }
  }
}
