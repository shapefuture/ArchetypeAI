{
  "name": "archetypeai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:styles": "tailwindcss -i src/index.css -o src/styles/tailwind.generated.css --config tailwind.config.cjs",
    "predev": "tailwindcss -i src/index.css -o src/styles/tailwind.generated.css --config tailwind.config.cjs",
    "dev": "bash scripts/run-with-node-version.sh ./node_modules/@angular/cli/bin/ng.js serve",
    "prebuild": "tailwindcss -i src/index.css -o src/styles/tailwind.generated.css --config tailwind.config.cjs",
    "build": "bash scripts/run-with-node-version.sh ./node_modules/@angular/cli/bin/ng.js build",
    "postbuild": "cp _headers dist/_headers",
    "_deploy:headers": "echo 'Verify _headers is in dist/ before wrangler deploy' && test -f dist/_headers",
    "preview": "bash scripts/run-with-node-version.sh ./node_modules/@angular/cli/bin/ng.js serve --configuration=production",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/sign-native-addons.mjs",
    "pretest": "tailwindcss -i src/index.css -o src/styles/tailwind.generated.css --config tailwind.config.cjs",
    "test": "bash scripts/run-with-node-version.sh ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@angular/animations": "^20.2.0",
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/platform-browser-dynamic": "^20.2.0",
    "@google/genai": "^1.49.0",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.3.3",
    "firebase": "^12.13.0",
    "gsap": "^3.14.2",
    "marked": "^12.0.2",
    "rxjs": "^7.8.2",
    "three": "^0.183.2",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@cloudflare/kv-asset-handler": "^0.4.2",
    "@cloudflare/workers-types": "^4.20260413.1",
    "@rollup/rollup-darwin-x64": "^4.59.0",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "jasmine-core": "^6.2.0",
    "jsdom": "^24.1.3",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vitest": "3.1.1"
  }
}
