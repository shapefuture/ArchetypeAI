{
  "name": "archetypeai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/stamp-parts-cartographer-sw.mjs",
    "postbuild": "cp _headers dist/_headers",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/sign-native-addons.mjs",
    "test": "bash scripts/run-with-node-version.sh ./node_modules/vitest/vitest.mjs run",
    "_deploy:headers": "echo 'Verify _headers is in dist/ before wrangler deploy' && test -f dist/_headers",
    "test:rules": "firebase emulators:exec --only firestore --project demo-archetypeai \"vitest run --config vitest.rules.config.ts\"",
    "test:browser": "playwright test",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "@google/genai": "^1.49.0",
    "dompurify": "^3.4.17",
    "firebase": "^12.19.0",
    "gsap": "^3.14.2",
    "jose": "^6.2.12",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/kv-asset-handler": "^0.4.2",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.32.1",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.28",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chokidar": "^4.0.3",
    "piscina": "^5.3.2"
  }
}
