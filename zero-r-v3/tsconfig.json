{
  "compilerOptions":{
    "target":"ES2022",
    "module":"ES2022",
    "moduleResolution":"Bundler",
    "strict":true,
    "noEmit":false,
    "outDir":"dist/assets",
    "rootDir":"src",
    "lib":["ES2022","DOM","DOM.Iterable","WebWorker"],
    "skipLibCheck":true,
    "forceConsistentCasingInFileNames":true,
    "verbatimModuleSyntax":true
  },
  "include":["src/**/*.ts"]
}
